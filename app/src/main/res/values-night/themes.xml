<resources>
    <style name="Theme.Monolith" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/mono_black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Monolith.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/mono_black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_monolith_fg_night</item>
        <item name="postSplashScreenTheme">@style/Theme.Monolith</item>
    </style>
</resources>
